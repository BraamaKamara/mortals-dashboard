# Environment Variables for MORTALS Dashboard

# Backend API URL for email verification
REACT_APP_API_URL=http://localhost:3001/api

# Optional websocket URL (if using sockets)
# REACT_APP_SOCKET_URL=ws://localhost:3001

# AI provider (backend)
OPENAI_API_KEY=your-openai-key
# Optional override, defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Optional: Set to 'production' to hide debug info
# NODE_ENV=production
